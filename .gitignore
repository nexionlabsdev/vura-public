# Node modules
node_modules/

# Compilation output
out/
dist/

# VS Code specific
.vscode/
.vscode-test/
*.vsix

# TypeScript build info
*.tsbuildinfo

# Packaging-only lockfile staged by install-local-deps.sh for every npm
# workspace member connector Add-on — the root package-lock.json is the one
# that's actually committed. This is machine- and run-specific (it points
# @vura-data-os/* deps at tarballs under a mktemp dir) and must never be
# committed.
packages/connectors/*/package-lock.json

# Dependency directories
jspm_packages/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env

# MacOS system files
.DS_Store

# Python build & runtime artifacts
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/

# vura-runner local runtime state
.vura/

# Sample file exports
samples/exported/

# tests output
tests/flows/
tests/*.html

# samples data
samples/data/
samples/requirements.txt
