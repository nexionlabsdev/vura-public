{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vura://sidecar/request.schema.json",
  "type": "object",
  "required": ["id", "code"],
  "properties": {
    "id": { "type": "string" },
    "code": { "type": "string" },
    "filename": { "type": "string" },
    "ctx": {
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "depthLimit": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
